{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/test_measure.schema.json",
  "title": "Test Measure Schema",
  "description": "Schema for verification/validation test measures",
  "allOf": [
    { "$ref": "artifact-base.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_type",
        "objective",
        "referenced_requirements",
        "referenced_designs",
        "preconditions",
        "environment",
        "stimuli",
        "steps",
        "expected_outcomes",
        "tolerances",
        "timing",
        "oracle_basis",
        "cleanup",
        "regression_selection"
      ],
      "$defs": {
        "stimulus": {
          "type": "object",
          "required": ["signal", "value", "timing"],
          "additionalProperties": false,
          "properties": {
            "signal": { "type": "string" },
            "value": { "type": "string" },
            "timing": { "type": "string" }
          }
        },
        "step": {
          "type": "object",
          "required": ["step", "action", "expected"],
          "additionalProperties": false,
          "properties": {
            "step": { "type": "integer", "minimum": 1 },
            "action": { "type": "string" },
            "expected": { "type": "string" }
          }
        },
        "expected_outcome": {
          "type": "object",
          "required": ["signal", "expected_value", "tolerance"],
          "additionalProperties": false,
          "properties": {
            "signal": { "type": "string" },
            "expected_value": { "type": "string" },
            "tolerance": { "type": "string" },
            "unit": { "type": "string" }
          }
        }
      },
      "properties": {
        "test_type": {
          "type": "string",
          "enum": ["unit", "integration", "system", "qualification", "validation", "fault_injection", "robustness", "boundary", "acceptance"]
        },
        "objective": {
          "type": "string",
          "description": "What this test measure verifies/validates"
        },
        "referenced_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Requirement IDs this test verifies"
        },
        "referenced_designs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Design IDs this test verifies"
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required state before test execution"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hardware", "software", "tools", "configuration"],
          "properties": {
            "hardware": { "type": "string" },
            "software": { "type": "string" },
            "tools": { "type": "array", "items": { "type": "string" } },
            "configuration": { "type": "string" }
          }
        },
        "stimuli": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stimulus" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "expected_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expected_outcome" }
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z_]+$": { "type": "number", "minimum": 0 }
          },
          "description": "Numerical tolerances for pass/fail criteria (key: tolerance name, value: threshold)"
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_execution_time_ms", "setup_time_ms", "teardown_time_ms"],
          "properties": {
            "max_execution_time_ms": { "type": "integer", "minimum": 0 },
            "setup_time_ms": { "type": "integer", "minimum": 0 },
            "teardown_time_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "oracle_basis": {
          "type": "string",
          "enum": ["source_grounded", "analytical_model", "synthetic_assumption", "measured_reference", "accepted_reference"],
          "description": "Basis for expected outcomes - must be distinguishable"
        },
        "cleanup": {
          "type": "string",
          "description": "Post-test cleanup actions"
        },
        "regression_selection": {
          "type": "string",
          "description": "Criteria for including in regression suite"
        }
      }
    }
  ]
}