{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foxbms2:schemas:review.schema.json",
  "title": "Review Artifact Schema",
  "description": "Schema for review artifacts in the foxBMS 2 lifecycle corpus",
  "allOf": [
    {
      "$ref": "artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "review_type",
        "reviewed_ids",
        "reviewer_identity",
        "checklist_version",
        "scope",
        "findings",
        "dispositions",
        "limitations"
      ],
      "properties": {
        "artifact_type": {
          "const": "review"
        },
        "review_type": {
          "type": "string",
          "enum": [
            "domain",
            "cross_domain",
            "adversarial",
            "challenge",
            "meta"
          ],
          "description": "Type of review performed"
        },
        "reviewed_ids": {
          "type": "array",
          "minItems": 1,
          "description": "List of artifacts reviewed with their revision and digest",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "revision",
              "digest"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "ID of the artifact that was reviewed"
              },
              "revision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Revision of the artifact at time of review"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 digest of the artifact at time of review"
              }
            },
            "additionalProperties": false
          }
        },
        "reviewer_identity": {
          "type": "object",
          "required": [
            "role",
            "session_id",
            "model"
          ],
          "properties": {
            "role": {
              "type": "string",
              "description": "Role of the reviewer (e.g., system_engineer, safety_engineer)"
            },
            "session_id": {
              "type": "string",
              "description": "Unique identifier for the review session"
            },
            "model": {
              "type": "string",
              "description": "Model used for the review (e.g., claude-opus-4-20250805)"
            },
            "note": {
              "type": "string",
              "description": "Optional note about the reviewer"
            }
          },
          "additionalProperties": false
        },
        "checklist_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Version of the review checklist used (semver)"
        },
        "scope": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "targeted",
            "incremental"
          ],
          "description": "Scope of the review: full (complete artifact), partial (subset), targeted (specific concerns), incremental (changes since last review)"
        },
        "findings": {
          "type": "array",
          "description": "Findings from the review",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "artifact_id",
              "severity",
              "description",
              "category",
              "evidence"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "Unique ID for this finding"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "ID of the artifact this finding relates to"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "description": "Severity of the finding"
              },
              "description": {
                "type": "string",
                "description": "Description of the finding"
              },
              "category": {
                "type": "string",
                "enum": [
                  "finding_provenance",
                  "finding_completeness",
                  "finding_domain",
                  "finding_cross_domain",
                  "finding_verification",
                  "finding_traceability",
                  "finding_consistency",
                  "finding_process"
                ],
                "description": "Category of the finding (prefixed to avoid confusion with review_type)"
              },
              "evidence": {
                "type": "string",
                "description": "Evidence supporting the finding"
              }
            },
            "additionalProperties": false
          }
        },
        "dispositions": {
          "type": "array",
          "description": "Dispositions for each finding",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "disposition",
              "action"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "ID of the finding this disposition addresses"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "accepted",
                  "rejected",
                  "deferred",
                  "partial",
                  "in_progress",
                  "duplicate",
                  "wont_fix"
                ],
                "description": "Disposition of the finding"
              },
              "action": {
                "type": "string",
                "description": "Action taken or planned"
              },
              "resolved_artifact_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Optional ID of artifact created to resolve this finding (null if not applicable)"
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "description": "Limitations of this review (AI review disclaimer, scope limitations)",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  ]
}