{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/review.schema.json",
  "title": "Review Artifact Schema",
  "description": "Schema for review artifacts in the foxBMS 2 lifecycle corpus",
  "allOf": [
    {
      "$ref": "artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "review_type",
        "reviewed_ids",
        "reviewer_identity",
        "checklist_version",
        "scope",
        "findings",
        "dispositions",
        "limitations"
      ],
      "properties": {
        "artifact_type": {
          "const": "review"
        },
        "review_type": {
          "type": "string",
          "enum": [
            "domain",
            "cross_domain",
            "adversarial",
            "challenge",
            "meta"
          ],
          "description": "Type of review performed"
        },
        "reviewed_ids": {
          "type": "array",
          "minItems": 1,
          "description": "List of artifacts reviewed with their revision and digest",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "revision",
              "digest"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "ID of the artifact that was reviewed"
              },
              "revision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "description": "Revision of the artifact at time of review"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 digest of the artifact at time of review"
              }
            },
            "additionalProperties": false
          }
        },
        "reviewer_identity": {
          "type": "object",
          "required": [
            "role",
            "session_id",
            "model"
          ],
          "properties": {
            "role": {
              "type": "string",
              "description": "Role of the reviewer (e.g., system_engineer, safety_engineer)"
            },
            "session_id": {
              "type": "string",
              "description": "Unique identifier for the review session"
            },
            "model": {
              "type": "string",
              "description": "Model used for the review (e.g., claude-opus-4-20250805)"
            },
            "note": {
              "type": "string",
              "description": "Optional note about the reviewer"
            }
          },
          "additionalProperties": false
        },
        "checklist_version": {
          "type": "string",
          "description": "Version of the review checklist used"
        },
        "scope": {
          "type": "string",
          "description": "What aspects were reviewed"
        },
        "findings": {
          "type": "array",
          "minItems": 0,
          "description": "Findings from the review",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "artifact_id",
              "severity",
              "description",
              "category",
              "evidence"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "Unique ID for this finding"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "ID of the artifact this finding relates to"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "description": "Severity of the finding"
              },
              "description": {
                "type": "string",
                "description": "Description of the finding"
              },
              "category": {
                "type": "string",
                "enum": [
                  "provenance",
                  "completeness",
                  "domain",
                  "cross_domain",
                  "verification",
                  "traceability",
                  "consistency",
                  "process"
                ],
                "description": "Category of the finding"
              },
              "evidence": {
                "type": "string",
                "description": "Evidence supporting the finding"
              }
            },
            "additionalProperties": false
          }
        },
        "dispositions": {
          "type": "array",
          "minItems": 0,
          "description": "Dispositions for each finding",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "disposition",
              "action"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "ID of the finding this disposition addresses"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "accepted",
                  "rejected",
                  "deferred",
                  "partial",
                  "in_progress"
                ],
                "description": "Disposition of the finding"
              },
              "action": {
                "type": "string",
                "description": "Action taken or planned"
              },
              "resolved_artifact_id": {
                "type": "string",
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$",
                "description": "Optional ID of artifact created to resolve this finding"
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "description": "Limitations of this review (AI review disclaimer, scope limitations)",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}