{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/assumption.schema.json",
  "title": "Assumption Schema",
  "description": "Schema for assumption artifacts in the foxBMS 2 lifecycle corpus",
  "allOf": [
    {
      "$ref": "artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "statement",
        "rationale",
        "affected_scope",
        "source",
        "validity_conditions",
        "invalidation_consequence",
        "review_status"
      ],
      "properties": {
        "artifact_type": {
          "const": "assumption"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The assumption statement/value"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Why this assumption is made"
        },
        "affected_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^FB2-[A-Z]{2,3}-[A-Z]{2,3}-[0-9]{6}$"
              },
              {
                "pattern": "\\S"
              }
            ],
            "description": "Artifact ID this assumption affects (format: FB2-XX-XX-XXXXXX)"
          },
          "description": "Artifact IDs this assumption affects"
        },
        "source": {
          "type": "string",
          "enum": [
            "source_observed",
            "derived",
            "synthetic"
          ],
          "description": "Provenance origin category"
        },
        "validity_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Condition under which assumption holds (non-empty)"
          },
          "description": "Conditions under which assumption holds"
        },
        "invalidation_consequence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "What happens if assumption is invalidated"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "accepted",
            "challenged",
            "invalidated"
          ],
          "description": "Current review status of the assumption"
        }
      }
    }
  ],
  "additionalProperties": false
}