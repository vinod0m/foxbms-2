{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://foxbms2.softwaredevlabs.org/schemas/verification_summary.schema.json",
 "title": "Software Verification Summary Schema",
 "description": "Schema for a software verification summary (the reporting counterpart of the SWE.4/SWE.5/SWE.6 verification plan). A summary that reports only successes is a marketing document, so this schema requires the failure and blocked sections to be non-empty and requires an overall verdict that is permitted to be incomplete. Every quantity must carry the evidence path it came from, and the schema requires an explicit statement of whether the verification is complete. It requires a target-hardware section, because a summary that does not say whether the product's own hardware was exercised has not answered the question a reader is asking.",
 "allOf": [
  {
   "$ref": "artifact-base.schema.json"
  },
  {
   "type": "object",
   "required": [
    "summary_id",
    "summary_basis",
    "period",
    "overall_verdict",
    "what_was_verified",
    "what_passed",
    "what_failed",
    "what_is_blocked",
    "target_hardware",
    "outstanding",
    "counts_with_sources",
    "independence_statement",
    "limitations"
   ],
   "properties": {
    "artifact_type": {
     "const": "verification_summary"
    },
    "summary_id": {
     "type": "string",
     "pattern": "^FB2-VER-VSR-[0-9]{6}$"
    },
    "summary_basis": {
     "type": "string",
     "minLength": 1
    },
    "period": {
     "type": "string",
     "minLength": 1
    },
    "overall_verdict": {
     "type": "object",
     "required": [
      "verdict",
      "statement"
     ],
     "properties": {
      "verdict": {
       "enum": [
        "complete",
        "incomplete",
        "not_started"
       ]
      },
      "statement": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    },
    "what_was_verified": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "item",
       "level",
       "how",
       "evidence_path"
      ],
      "properties": {
       "item": {
        "type": "string",
        "minLength": 1
       },
       "level": {
        "type": "string",
        "minLength": 1
       },
       "how": {
        "type": "string",
        "minLength": 1
       },
       "evidence_path": {
        "type": "string",
        "minLength": 1
       },
       "evidence_sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       }
      },
      "additionalProperties": false
     }
    },
    "what_passed": {
     "type": "object",
     "required": [
      "statement",
      "items"
     ],
     "properties": {
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "items": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "additionalProperties": false
    },
    "what_failed": {
     "type": "object",
     "required": [
      "statement",
      "items"
     ],
     "description": "Cannot be empty. A summary with no failures either found none, which is implausible, or is not reporting.",
     "properties": {
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "items": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "additionalProperties": false
    },
    "what_is_blocked": {
     "type": "object",
     "required": [
      "statement",
      "items"
     ],
     "description": "Cannot be empty while the verdict is incomplete.",
     "properties": {
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "items": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "item",
         "blocked_because",
         "unblock_condition"
        ],
        "properties": {
         "item": {
          "type": "string",
          "minLength": 1
         },
         "blocked_because": {
          "type": "string",
          "minLength": 1
         },
         "unblock_condition": {
          "type": "string",
          "minLength": 1
         }
        },
        "additionalProperties": false
       }
      }
     },
     "additionalProperties": false
    },
    "target_hardware": {
     "type": "object",
     "required": [
      "performed",
      "statement"
     ],
     "description": "Mandatory. Whether the verification was performed on the product's own hardware is the first question a reader of a BMS verification summary asks.",
     "properties": {
      "performed": {
       "type": "boolean"
      },
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "what_a_target_run_would_add": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    },
    "outstanding": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "counts_with_sources": {
     "type": "array",
     "minItems": 1,
     "description": "Every quantity published in this summary, with the file it was read from. A count with no source is not publishable.",
     "items": {
      "type": "object",
      "required": [
       "claim",
       "value",
       "source_path",
       "source_sha256"
      ],
      "properties": {
       "claim": {
        "type": "string",
        "minLength": 1
       },
       "value": {
        "type": "string",
        "minLength": 1
       },
       "source_path": {
        "type": "string",
        "minLength": 1
       },
       "source_sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       },
       "derivation": {
        "type": "string",
        "minLength": 1
       }
      },
      "additionalProperties": false
     }
    },
    "independence_statement": {
     "type": "string",
     "minLength": 1
    },
    "limitations": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   },
   "additionalProperties": true
  }
 ]
}