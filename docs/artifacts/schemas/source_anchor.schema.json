{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/source_anchor.schema.json",
  "title": "Source Anchor Schema",
  "description": "Schema for source anchor artifacts in the foxBMS 2 lifecycle corpus",
  "allOf": [
    {
      "$ref": "artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "source_type",
        "location",
        "content_hash",
        "retrieval_date"
      ],
      "properties": {
        "artifact_type": {
          "const": "source_anchor"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "code",
            "hardware",
            "documentation",
            "test"
          ],
          "description": "Type of source being anchored"
        },
        "location": {
          "type": "object",
          "oneOf": [
            {
              "description": "Code source location",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Repository name or URL"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$",
                  "description": "Git commit SHA"
                },
                "path": {
                  "type": "string",
                  "description": "File path in repository"
                },
                "symbol": {
                  "type": "string",
                  "description": "Symbol name (function, variable, class, etc.)"
                },
                "line_range": {
                  "type": "string",
                  "pattern": "^[0-9]+-[0-9]+$",
                  "description": "Line range in format 'start-end'"
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 hash of the content"
                },
                "working_file_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 hash of working file (if different from committed)"
                }
              },
              "required": [
                "repository",
                "commit",
                "path",
                "symbol",
                "line_range",
                "content_hash"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "board_revision": {
                  "type": "string",
                  "description": "Hardware board revision identifier"
                },
                "file": {
                  "type": "string",
                  "description": "Hardware design file (schematic, PCB, BOM)"
                },
                "sheet_page": {
                  "type": "string",
                  "description": "Schematic sheet or page number"
                },
                "reference_designator": {
                  "type": "string",
                  "description": "Component reference designator"
                },
                "net_connector_pin": {
                  "type": "string",
                  "description": "Net or connector pin identifier"
                },
                "file_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 hash of the hardware design file"
                }
              },
              "required": [
                "board_revision",
                "file",
                "sheet_page",
                "reference_designator",
                "file_hash"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "url_or_path": {
                  "type": "string",
                  "description": "URL or local path to documentation"
                },
                "version": {
                  "type": "string",
                  "description": "Document version"
                },
                "section_anchor": {
                  "type": "string",
                  "description": "Section anchor or heading"
                },
                "retrieval_date": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Date and time of retrieval"
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 hash of the document content"
                }
              },
              "required": [
                "url_or_path",
                "version",
                "section_anchor",
                "retrieval_date",
                "content_hash"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "file_or_executable": {
                  "type": "string",
                  "description": "Test file or executable name"
                },
                "version": {
                  "type": "string",
                  "description": "Test version"
                },
                "configuration": {
                  "type": "string",
                  "description": "Test configuration"
                },
                "assertion_report": {
                  "type": "string",
                  "description": "Assertion report or test result"
                }
              },
              "required": [
                "file_or_executable",
                "version",
                "configuration",
                "assertion_report"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Source location details based on source_type"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 content hash of the source"
        },
        "retrieval_date": {
          "type": "string",
          "format": "date-time",
          "description": "When the source was accessed/retrieved"
        }
      },
      "additionalProperties": true
    }
  ]
}
