{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/use_case.schema.json",
  "title": "Use Case Schema",
  "description": "Schema for a use case with its operational scenarios (Automotive SPICE SYS.1). The use case is the operational narrative a validation measure is written against; the operational scenarios inside it are the concrete situations in which the item's behaviour can be wrong, each with the signal, the environment and the expected outcome a validation measure can check. A use case that carries no operational scenarios cannot be validated, and that state is reported rather than papered over.",
  "allOf": [
    {
      "$ref": "artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "use_case_id",
        "use_case_name",
        "primary_stakeholders",
        "preconditions",
        "main_success_scenario",
        "operational_scenarios",
        "postconditions",
        "validation_measures",
        "limitations"
      ],
      "properties": {
        "artifact_type": {
          "const": "use_case"
        },
        "use_case_id": {"type": "string", "pattern": "^FB2-SYS-UC-[0-9]{6}$"},
        "use_case_name": {"type": "string", "minLength": 1},
        "primary_stakeholders": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^FB2-SYS-NED-[0-9]{6}$"},
          "description": "Stakeholder-need records this use case serves."
        },
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "main_success_scenario": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step", "action", "expected_observable_outcome"],
            "properties": {
              "step": {"type": "integer", "minimum": 1},
              "action": {"type": "string", "minLength": 1},
              "expected_observable_outcome": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "operational_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scenario_id", "operational_situation", "initial_conditions", "perturbation", "expected_item_behaviour", "expected_observable_outcome", "observable_by"],
            "properties": {
              "scenario_id": {"type": "string", "pattern": "^OS-[0-9]{3}$"},
              "operational_situation": {"type": "string", "minLength": 1},
              "initial_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "perturbation": {
                "type": "string",
                "minLength": 1,
                "description": "What the environment does to the item. Required: a scenario without a perturbation is a description of nominal operation, which the success scenario already covers."
              },
              "expected_item_behaviour": {"type": "string", "minLength": 1},
              "expected_observable_outcome": {"type": "string", "minLength": 1},
              "observable_by": {
                "type": "string",
                "minLength": 1,
                "description": "Who or what observes the outcome. An outcome nobody can observe is not a validation criterion."
              },
              "safe_state_interaction": {"type": "string"},
              "related_hazard_refs": {"type": "array", "items": {"type": "string"}},
              "related_requirement_refs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_measures": {
          "type": "array",
          "items": {"type": "string", "pattern": "^FB2-VER-TMS-[0-9]{6}$"},
          "description": "Validation measures written against this use case. May be empty, in which case limitations must say the use case is unvalidated."
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  ]
}
