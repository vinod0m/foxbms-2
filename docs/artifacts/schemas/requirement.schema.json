{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/requirement.schema.json",
  "$comment": "Base domain for schema IDs; override via build-time substitution if needed",
  "title": "Requirement Schema",
  "description": "Schema for requirement artifacts extending the artifact base schema",
  "allOf": [
    {
      "$ref": "./artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "statement",
        "rationale",
        "classification",
        "acceptance_criteria",
        "verification_approach",
        "safety_allocation",
        "assumptions",
        "conditions_modes",
        "feasibility_dependencies"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "const": "requirement"
        },
        "statement": {
          "type": "string",
          "description": "Atomic requirement statement (shall/should)"
        },
        "rationale": {
          "type": "string",
          "description": "Why this requirement exists"
        },
        "classification": {
          "type": "string",
          "enum": [
            "functional",
            "non_functional",
            "interface",
            "performance",
            "safety",
            "security",
            "regulatory",
            "quality",
            "management",
            "process",
            "organizational"
          ],
          "description": "Requirement classification category"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "description": "Acceptance criteria for verifying the requirement (at least one criterion required)",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "measure",
              "threshold"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "description": "Acceptance criterion description"
              },
              "measure": {
                "type": "string",
                "description": "Measurement method or metric"
              },
              "threshold": {
                "type": "string",
                "description": "Pass/fail threshold value"
              },
              "unit": {
                "type": "string",
                "description": "Unit of measurement (optional)"
              }
            },
            "additionalProperties": false
          }
        },
        "verification_approach": {
          "type": "string",
          "enum": [
            "test",
            "analysis",
            "inspection",
            "demonstration",
            "review"
          ],
          "description": "Verification approach for this requirement"
        },
        "safety_allocation": {
          "type": "object",
          "required": [
            "asil",
            "safety_goal_ref",
            "mitigation"
          ],
          "properties": {
            "asil": {
              "type": "string",
              "enum": [
                "QM",
                "ASIL_A",
                "ASIL_B",
                "ASIL_C",
                "ASIL_D",
                "qm",
                "asil_a",
                "asil_b",
                "asil_c",
                "asil_d",
                "not_applicable"
              ],
              "description": "Automotive Safety Integrity Level"
            },
            "safety_goal_ref": {
              "type": "string",
              "description": "Reference to safety goal this requirement supports"
            },
            "mitigation": {
              "type": "string",
              "description": "Safety mitigation description"
            }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Assumption IDs this requirement depends on"
        },
        "conditions_modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operating conditions/modes where requirement applies"
        },
        "feasibility_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other requirement/design IDs this requirement depends on for feasibility"
        }
      },
      "additionalProperties": true
    }
  ]
}
