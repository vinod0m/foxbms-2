{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/design.schema.json",
  "title": "Design Artifact Schema",
  "description": "Schema for design artifacts in the foxBMS 2 lifecycle corpus, extending artifact-base.schema.json",
  "allOf": [
    {
      "$ref": "./artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "design_level",
        "responsibilities"
      ],
      "$defs": {
        "non_negative_number": {
          "type": "number",
          "minimum": 0
        },
        "identifier": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Valid identifier (letter/underscore start, alphanumeric/underscore)"
        },
        "signal_type": {
          "type": "string",
          "pattern": "^(u?int(8|16|32|64)|float(32|64)|bool)$",
          "description": "Standard signal data types"
        },
        "signal_unit": {
          "type": "string",
          "pattern": "^(V|A|Hz|kHz|MHz|degC|rpm|s|ms|us|ns|m|mm|cm|km|kg|g|N|Pa|W|J|C|F|H|Ohm|S|T|Wb|lx|lm|cd|rad|sr|mol|K|dimensionless|%|count)$",
          "description": "Standard physical units"
        },
        "signal_range": {
          "type": "string",
          "pattern": "^(-?\\d+(\\.\\d+)?\\.\\.-?\\d+(\\.\\d+)?|-?\\d+(\\.\\d+)?)$",
          "description": "Range format: min..max or single value"
        },
        "signal_rate": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ms|us|ns|Hz|kHz|MHz)|event-driven)$",
          "description": "Update rate: number with unit (ms, us, ns, Hz, kHz, MHz) or event-driven"
        },
        "decision_id_pattern": {
          "type": "string",
          "pattern": "^DEC-\\d{3,}$",
          "description": "Decision ID format: DEC-XXX"
        },
        "interface_id_pattern": {
          "type": "string",
          "pattern": "^IF-\\d{3,}$",
          "description": "Interface ID format: IF-XXX"
        }
      },
      "properties": {
        "artifact_type": {
          "const": "design"
        },
        "design_level": {
          "type": "string",
          "enum": [
            "architecture_design",
            "detailed_design",
            "interface_specification"
          ],
          "description": "Level of design abstraction (snake_case)"
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "What this design element is responsible for"
        },
        "decomposition": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "child_id",
              "relationship"
            ],
            "properties": {
              "child_id": {
                "$ref": "#/$defs/identifier",
                "description": "ID of the child design element"
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "contains",
                  "uses",
                  "delegates_to"
                ],
                "description": "Type of relationship to child element (snake_case)"
              }
            },
            "additionalProperties": false
          },
          "description": "Child design elements and their relationships"
        },
        "interfaces": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "interface_id",
              "direction",
              "signals"
            ],
            "properties": {
              "interface_id": {
                "$ref": "#/$defs/interface_id_pattern",
                "description": "Unique identifier for this interface (format: IF-XXX)"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "input",
                  "output",
                  "bidirectional"
                ],
                "description": "Direction of data flow through this interface"
              },
              "signals": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "unit",
                    "range"
                  ],
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/identifier",
                      "description": "Signal name (valid identifier)"
                    },
                    "type": {
                      "$ref": "#/$defs/signal_type",
                      "description": "Signal data type (e.g., uint16, float32, bool)"
                    },
                    "unit": {
                      "$ref": "#/$defs/signal_unit",
                      "description": "Physical unit (e.g., V, A, degC, rpm, dimensionless)"
                    },
                    "range": {
                      "$ref": "#/$defs/signal_range",
                      "description": "Valid range (e.g., 0..5, -40..85, 0/1)"
                    },
                    "rate": {
                      "$ref": "#/$defs/signal_rate",
                      "description": "Update rate or frequency (e.g., 10ms, 100Hz, event-driven)"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Signals carried by this interface"
              }
            },
            "additionalProperties": false
          },
          "description": "Interfaces exposed by this design element"
        },
        "behavior_model": {
          "type": "object",
          "required": [
            "type",
            "states",
            "transitions"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "state_machine",
                "data_flow",
                "sequence_diagram",
                "combination_model"
              ],
              "description": "Type of behavioral model (snake_case)"
            },
            "states": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "description": "List of states in the behavior model"
            },
            "transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "trigger"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/$defs/identifier",
                    "description": "Source state"
                  },
                  "to": {
                    "$ref": "#/$defs/identifier",
                    "description": "Target state"
                  },
                  "trigger": {
                    "type": "string",
                    "description": "Event or condition causing transition"
                  },
                  "guard": {
                    "type": "string",
                    "description": "Optional guard condition"
                  },
                  "action": {
                    "type": "string",
                    "description": "Optional action executed on transition"
                  }
                },
                "additionalProperties": false
              },
              "description": "Transitions between states"
            }
          },
          "additionalProperties": false,
          "description": "Behavioral model of the design element"
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Timing, memory, resource, platform constraints"
        },
        "budgets": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "cpu_time_ms": {
              "$ref": "#/$defs/non_negative_number",
              "description": "CPU time budget in milliseconds"
            },
            "memory_bytes": {
              "$ref": "#/$defs/non_negative_number",
              "description": "Memory budget in bytes"
            },
            "stack_bytes": {
              "$ref": "#/$defs/non_negative_number",
              "description": "Stack size budget in bytes"
            },
            "bus_bandwidth_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Bus bandwidth utilization budget as percentage (0-100)"
            }
          },
          "additionalProperties": false,
          "description": "Resource budgets (at least one required if present)"
        },
        "failure_response": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "failure_mode",
              "detection",
              "reaction"
            ],
            "properties": {
              "failure_mode": {
                "type": "string",
                "description": "Description of the failure mode"
              },
              "detection": {
                "type": "string",
                "description": "How the failure is detected"
              },
              "reaction": {
                "type": "string",
                "description": "System reaction to the failure"
              },
              "recovery": {
                "type": "string",
                "description": "Optional recovery procedure"
              }
            },
            "additionalProperties": false
          },
          "description": "Failure modes and responses"
        },
        "decisions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "decision_id",
              "alternatives",
              "selected",
              "rationale"
            ],
            "properties": {
              "decision_id": {
                "$ref": "#/$defs/decision_id_pattern",
                "description": "Unique identifier for this decision (format: DEC-XXX)"
              },
              "alternatives": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                },
                "description": "Alternative options considered"
              },
              "selected": {
                "type": "string",
                "description": "Selected alternative"
              },
              "rationale": {
                "type": "string",
                "description": "Reason for selection"
              }
            },
            "additionalProperties": false
          },
          "description": "Design decisions with rationale"
        },
        "implementation_mapping": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "source_file",
              "symbol",
              "status"
            ],
            "properties": {
              "source_file": {
                "$ref": "#/$defs/identifier",
                "description": "Path to source file implementing this design"
              },
              "symbol": {
                "$ref": "#/$defs/identifier",
                "description": "Function, class, or variable name in source"
              },
              "status": {
                "type": "string",
                "enum": [
                  "implemented",
                  "proposed",
                  "partial",
                  "missing"
                ],
                "description": "Implementation status (snake_case)"
              }
            },
            "additionalProperties": false
          },
          "description": "Mapping from design elements to source code"
        }
      }
    }
  ]
}