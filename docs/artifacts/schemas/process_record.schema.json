{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxbms2.softwaredevlabs.org/schemas/process_record.schema.json",
  "title": "Supporting Process Record Schema",
  "description": "Schema for a populated supporting or organisational process record (Automotive SPICE SUP.1, SUP.8, SUP.9, SUP.10, ACQ.4, REU.2 and their relatives). Master prompt section 12 is explicit: provide populated process records, not just policies. A policy states what the process is; this schema additionally requires the process's own inputs and outputs, the accountable role, the acceptance criteria by which an instance is judged conforming, and at least one recorded instance with named fictional participants, a synthetic date and a decision. A record whose only populated field is the definition is a policy and is not accepted here.",
  "allOf": [
    {
      "$ref": "artifact-base.schema.json"
    },
    {
      "type": "object",
      "required": [
        "process_record_id",
        "aspice_process_id",
        "process_name",
        "fictional_organisation",
        "purpose",
        "inputs",
        "outputs",
        "accountable_role",
        "acceptance_criteria",
        "performed_instances",
        "review_and_communication",
        "traceability",
        "limitations"
      ],
      "properties": {
        "artifact_type": {
          "const": "process_record"
        },
        "process_record_id": {"type": "string", "pattern": "^FB2-SUP-[A-Z]{3}-[0-9]{6}$"},
        "aspice_process_id": {
          "type": "string",
          "pattern": "^(SUP|ACQ|REU|MAN|PIM|SPL|VAL|MLE)\\.[0-9]+$",
          "description": "The Automotive SPICE 4.1 process id this record populates. Recorded verbatim so a reader can look the process up rather than infer it from the title."
        },
        "process_name": {"type": "string", "minLength": 1},
        "fictional_organisation": {
          "type": "object",
          "required": ["name", "is_a_real_organisation"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Fictional supplier or programme name. Must not name a real company, supplier or foxBMS maintainer."
            },
            "is_a_real_organisation": {"const": false}
          },
          "additionalProperties": false
        },
        "purpose": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["input", "kind", "controlled_by"],
            "properties": {
              "input": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "enum": ["artifact", "record", "data", "decision", "external_input"]},
              "controlled_by": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["output", "kind", "retention"],
            "properties": {
              "output": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "enum": ["artifact", "record", "data", "decision", "identification_record", "external_output"]},
              "retention": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "accountable_role": {
          "type": "object",
          "required": ["role", "independence"],
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "independence": {
              "type": "string",
              "minLength": 1,
              "description": "Whether this role may approve work it produced. Required because 'independent' is the load-bearing word in every quality process."
            }
          },
          "additionalProperties": false
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["criterion", "how_conformance_is_checked"],
            "properties": {
              "criterion": {"type": "string", "minLength": 1},
              "how_conformance_is_checked": {"type": "string", "minLength": 1},
              "evidence_of_conformance": {"type": "string"}
            },
            "additionalProperties": false
          },
          "description": "Minimum two so a process cannot be accepted on a single vacuous criterion."
        },
        "performed_instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["instance_id", "instance_date", "instance_description", "participants", "inputs_used", "decision_or_outcome", "synthetic_decision", "conformance_against_acceptance_criteria"],
            "properties": {
              "instance_id": {"type": "string", "pattern": "^FB2-SUP-[A-Z]{3}-[0-9]{6}$-I[0-9]{2}|^INST-[0-9]{3}$"},
              "instance_date": {"type": "string", "format": "date"},
              "instance_description": {"type": "string", "minLength": 1},
              "participants": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["role", "named_as", "is_a_real_person"],
                  "properties": {
                    "role": {"type": "string", "minLength": 1},
                    "named_as": {"type": "string", "minLength": 1},
                    "is_a_real_person": {"const": false}
                  },
                  "additionalProperties": false
                }
              },
              "inputs_used": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "outputs_produced": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "decision_or_outcome": {"type": "string", "minLength": 1},
              "synthetic_decision": {
                "type": "string",
                "pattern": "^synthetic_decision:[a-z_]{3,40}:[A-Z0-9-]{3,60}$"
              },
              "conformance_against_acceptance_criteria": {
                "type": "string",
                "enum": ["conforming", "non_conforming", "partially_conforming"],
                "description": "Honest verdict. 'partially_conforming' is a legitimate outcome and is preferred over 'conforming' when any criterion is unmet."
              },
              "non_conformances_found": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "description": "At least one performed instance is mandatory. This is the field that distinguishes a process record from a process policy."
        },
        "review_and_communication": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["communication_id", "date", "communicated_artifact_revisions", "attendee_roles", "acknowledgement_recorded"],
            "properties": {
              "communication_id": {"type": "string", "pattern": "^COM-[0-9]{3}$"},
              "date": {"type": "string", "format": "date"},
              "communicated_artifact_revisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "attendee_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "acknowledgement_recorded": {"type": "boolean"},
              "acknowledgement_record_ref": {"type": "string"},
              "acknowledgement_note": {
                "type": "string",
                "minLength": 1,
                "description": "Required whenever acknowledgement_recorded is false, so that a missing acknowledgement carries a stated reason rather than an empty boolean."
              }
            },
            "additionalProperties": false
          }
        },
        "traceability": {
          "type": "object",
          "required": ["produces_records", "depends_on_records", "controlled_by_records"],
          "properties": {
            "produces_records": {"type": "array", "items": {"type": "string"}},
            "depends_on_records": {"type": "array", "items": {"type": "string"}},
            "controlled_by_records": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "process_performance_measurement": {
          "type": "object",
          "required": ["metric_id", "metric_name", "unit", "how_measured"],
          "properties": {
            "metric_id": {"type": "string", "pattern": "^MET-[0-9]{2}$"},
            "metric_name": {"type": "string", "minLength": 1},
            "unit": {"type": "string", "minLength": 1},
            "how_measured": {"type": "string", "minLength": 1},
            "measurement_plan_ref": {"type": "string"}
          },
          "additionalProperties": false
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  ]
}
