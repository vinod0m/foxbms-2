 "behavior_model": {
  "type": "state_machine",
  "states": [
   "OPEN",
   "PRECHARGE",
   "PRECHARGE_WAIT",
   "CLOSE",
   "HOLD",
   "FAULT_OPEN",
   "WELD_DETECTED",
   "STUCK_OPEN"
  ],
  "transitions": [
   {
    "from": "OPEN",
    "to": "PRECHARGE",
    "trigger": "request_precharge",
    "guard": "interlock_closed",
    "action": "close_precharge, start_timer"
   },
   {
    "from": "PRECHARGE",
    "to": "PRECHARGE_WAIT",
    "trigger": "precharge_contactor_closed",
    "guard": "feedback_confirmed",
    "action": "monitor_voltage"
   },
   {
    "from": "PRECHARGE_WAIT",
    "to": "CLOSE",
    "trigger": "voltage_threshold_reached",
    "guard": "v_precharge > v_threshold",
    "action": "close_main, open_precharge"
   },
   {
    "from": "CLOSE",
    "to": "HOLD",
    "trigger": "main_contactor_closed",
    "guard": "feedback_confirmed",
    "action": "enable_monitoring"
   },
   {
    "from": "HOLD",
    "to": "FAULT_OPEN",
    "trigger": "fault_request",
    "guard": "always",
    "action": "open_all, report_fault"
   },
   {
    "from": "HOLD",
    "to": "OPEN",
    "trigger": "request_open",
    "guard": "always",
    "action": "open_all"
   },
   {
    "from": "*",
    "to": "FAULT_OPEN",
    "trigger": "fault_request",
    "guard": "always",
    "action": "open_all, report_fault"
   },
   {
    "from": "HOLD",
    "to": "WELD_DETECTED",
    "trigger": "feedback_mismatch",
    "guard": "feedback_closed when commanded open",
    "action": "report_weld"
   },
   {
    "from": "HOLD",
    "to": "STUCK_OPEN",
    "trigger": "feedback_mismatch",
    "guard": "feedback_open when commanded closed",
    "action": "report_stuck_open"
   }
  ]
 },
 "constraints": [
  "Precharge timeout: configurable (default 5 s)",
  "Voltage threshold: configurable (default 95% pack voltage)",
  "Feedback debounce: 10 ms",
  "Cycle count persisted to FRAM",
  "Emergency open: < 5 ms from fault request"
 ],
 "budgets": {
  "cpu_time_ms": 1,
  "memory_bytes": 2048,
  "stack_bytes": 512
 },
 "failure_response": [
  {
   "failure_mode": "Weld detected",
   "detection": "Feedback closed when commanded open",
   "reaction": "FAULT_OPEN, report to DIAG",
   "recovery": "Manual intervention required"
  },
  {
   "failure_mode": "Stuck open",
   "detection": "Feedback open when commanded closed",
   "reaction": "FAULT_OPEN, retry once",
   "recovery": "Retry on next request"
  },
  {
   "failure_mode": "Precharge timeout",
   "detection": "Timer expired",
   "reaction": "OPEN, report timeout",
   "recovery": "Retry on next request"
  }
 ],
 "decisions": [
  {
   "decision_id": "DEC-CONT-001",
   "alternatives": [
    "Single contactor",
    "Dual contactor (series)",
    "Dual contactor (parallel)"
   ],
   "selected": "Dual contactor (series, plus/minus)",
   "rationale": "Redundant isolation, single-point fault tolerance"
  },
  {
   "decision_id": "DEC-CONT-002",
   "alternatives": [
    "Passive precharge",
    "Active precharge (current limited)"
   ],
   "selected": "Passive precharge (resistor)",
   "rationale": "Simpler, proven, no active components in precharge path"
  }
 ],
