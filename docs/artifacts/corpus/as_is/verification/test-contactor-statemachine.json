 "stimuli": [
  {
   "signal": "state_request",
   "value": "PRECHARGE",
   "timing": "t=0"
  },
  {
   "signal": "interlock",
   "value": "closed",
   "timing": "t=0"
  },
  {
   "signal": "precharge_feedback",
   "value": "closed",
   "timing": "t=10ms"
  },
  {
   "signal": "pack_voltage",
   "value": "400V",
   "timing": "t=100ms"
  },
  {
   "signal": "main_feedback",
   "value": "closed",
   "timing": "t=105ms"
  }
 ],
 "steps": [
  {
   "step": 1,
   "action": "Request PRECHARGE",
   "expected": "Precharge contactor coil energized"
  },
  {
   "step": 2,
   "action": "Simulate precharge feedback closed",
   "expected": "State -> PRECHARGE_WAIT"
  },
  {
   "step": 3,
   "action": "Simulate pack voltage > threshold",
   "expected": "Main contactor energized, precharge de-energized"
  },
  {
   "step": 4,
   "action": "Simulate main feedback closed",
   "expected": "State -> HOLD"
  },
  {
   "step": 5,
   "action": "Inject FAULT request",
   "expected": "All coils de-energized within 5 ms"
  },
  {
   "step": 6,
   "action": "Verify feedback open",
   "expected": "State -> FAULT_OPEN"
  }
 ],
 "expected_outcomes": [
  {
   "signal": "precharge_coil",
   "expected_value": "energized",
   "tolerance": "exact",
   "unit": "state"
  },
  {
   "signal": "main_coil",
   "expected_value": "energized",
   "tolerance": "exact",
   "unit": "state"
  },
  {
   "signal": "fault_response_latency",
   "expected_value": "< 5",
   "tolerance": "max",
   "unit": "ms"
  },
  {
   "signal": "final_state",
   "expected_value": "FAULT_OPEN",
   "tolerance": "exact",
   "unit": "enum"
  }
 ],
